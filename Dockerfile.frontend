# Multi-stage build for optimized production frontend image
# Stage 1: Builder
FROM node:20.18-alpine AS builder

# Set metadata labels
LABEL maintainer="Krsumit449@gmail.com"
LABEL description="DevOps Notes Frontend - React + Vite + Nginx"
LABEL version="1.0"

WORKDIR /app

# Install dependencies first (leverages Docker layer caching)
COPY frontend/package*.json ./
RUN npm ci --no-audit --no-fund && \
    npm cache clean --force

ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# Copy source and build
COPY frontend/ ./
RUN npm run build

# Stage 2: Production runtime
FROM nginxinc/nginx-unprivileged:1.27-alpine

# Set metadata labels
LABEL maintainer="Krsumit449@gmail.com"
LABEL description="DevOps Notes Frontend - Production Nginx"
LABEL version="1.0"

# Nginx unprivileged image runs as uid 101 (nginx) and listens on port 8080
ENV PORT=8080

WORKDIR /usr/share/nginx/html

# Switch to root temporarily to clean and copy files
USER root

# Remove default nginx static assets
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy custom nginx configuration
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Ensure proper ownership for the unprivileged nginx user
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Drop back to unprivileged user for runtime
USER nginx

# Expose the port Cloud Run expects
EXPOSE 8080

# Health check for container orchestration
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD sh -c "wget --quiet --tries=1 --spider http://localhost:8080/health || curl -sf http://localhost:8080/health > /dev/null"

# Run nginx in foreground so Docker receives signals properly
CMD ["nginx", "-g", "daemon off;"]
